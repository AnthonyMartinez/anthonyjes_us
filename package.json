{
  "name": "personal-site",
  "version": "1.0.0",
  "private": true,
  "description": "Personal website built with Next.js and Payload CMS",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "predev": "npm run generate:importmap",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "prebuild": "npm run generate:importmap",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "next lint"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "^3.90.0",
    "@payloadcms/next": "^3.90.0",
    "@payloadcms/richtext-lexical": "^3.90.0",
    "@payloadcms/ui": "^3.90.0",
    "cross-env": "^7.0.3",
    "graphql": "^16.9.0",
    "next": "~15.4.10",
    "payload": "^3.90.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sharp": "^0.34.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  }
}
