# Copy to .env and fill in.

# Long random string used to sign auth tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me

# SQLite file for local development. Also accepts a libSQL/Turso URL
# (libsql://your-db.turso.io) for hosted deployments.
DATABASE_URI=file:./personal-site.db
# Only needed for Turso / libSQL:
# DATABASE_AUTH_TOKEN=

# Public URL of the site, used for metadata and absolute links.
# On the server: https://your-domain.com (baked in at build time).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only: the domain Caddy requests an HTTPS certificate for.
# DOMAIN=your-domain.com
